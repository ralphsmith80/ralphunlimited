---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LabTabs from '../../components/lab/LabTabs.astro';
import ScorePair from '../../components/lab/ScorePair.astro';
import { SITE_TITLE } from '../../consts';
import { benchmarks, runLabel, stats } from '../../lib/lab';
import { imageLab, preview, producedPrompts } from '../../lib/image-lab';
import { leader } from '../../lib/leaders';
import labCollage from '../../assets/images/lab-collage.webp';
import '../../styles/lab.css';

const gameRuns = benchmarks.flatMap((benchmark) => benchmark.runs.map((run) => ({ benchmark, run })));
const bestHarness = leader(gameRuns.map(({ run }) => ({ label: runLabel(run), score: run.total })));
// Player ratings arrive from Convex keyed "benchId/runSlug"; this names the winner.
const gameLabels = Object.fromEntries(
	gameRuns.map(({ benchmark, run }) => [`${benchmark.id}/${run.slug}`, runLabel(run)]),
);

const { suite, runs: imageRuns } = imageLab;
const imageCount = imageRuns.reduce((sum, run) => sum + run.images.filter((image) => image.file).length, 0);
const bestChecks = leader(imageRuns.map((run) => ({ label: run.model, score: run.total })));
const allPass = imageRuns.length > 0 && imageRuns.every((run) => run.total === 100);
const imageRunsForScript = imageRuns.map((run) => ({ slug: run.slug, model: run.model, produced: producedPrompts(run) }));
// The image card shows the first three outputs; before any run is published, the fixed references.
const imageArt = imageRuns[0]
	? imageRuns[0].images.filter((image) => image.file).slice(0, 3).map(preview)
	: Object.keys(suite.references).map((file) => `/lab/images/${file}`);
const description =
	'AI models get the same task and one try. A script scores what it can measure. You score the rest, for game builds and images.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`The Lab | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main class="lab-main">
			<LabTabs active="overview" />
			<div class="lab-header lab-home-header">
				<span class="lab-eyebrow">The Lab</span>
				<h1>AI benchmarks you can judge</h1>
				<p class="lab-lede">
					I give AI models the same task and one try. A script scores what it can measure. You score the
					rest.
				</p>
			</div>

			<div class="lab-wings">
				<article class="lab-wing">
					<a class="lab-wing-art" href="/lab/games/" tabindex="-1" aria-hidden="true">
						<img src={labCollage.src} alt="" width={labCollage.width} height={labCollage.height} />
					</a>
					<div class="lab-wing-body">
						<span class="lab-section-eyebrow">Games</span>
						<h2><a href="/lab/games/">Game benchmarks</a></h2>
						<p>Coding models rebuild my old games. Play every build in your browser and rate it.</p>
						<div class="lab-stats">
							<div class="lab-stat"><b>{stats.benchmarks}</b><span>Benchmarks</span></div>
							<div class="lab-stat"><b>{stats.runs}</b><span>Runs</span></div>
							<div class="lab-stat"><b>{stats.playable}</b><span>Playable</span></div>
						</div>
						<div data-game-pair data-labels={JSON.stringify(gameLabels)}>
							<ScorePair
								compact
								machine={{
									label: 'Harness',
									value: bestHarness?.score ?? '–',
									max: 100,
									sub: bestHarness ? `best · ${bestHarness.label}` : 'no runs yet',
								}}
								human={{ label: 'Players', max: 5 }}
							/>
						</div>
						<div class="lab-wing-foot">
							<span>Rate fun, depth, and polish</span>
							<a class="btn btn-sm" href="/lab/games/#play-the-builds">Play the builds →</a>
						</div>
					</div>
				</article>

				<article class="lab-wing">
					<a
						class="lab-wing-art lab-wing-art--grid"
						href="/lab/image-quality/"
						tabindex="-1"
						aria-hidden="true"
						style={`grid-template-columns:repeat(${Math.max(1, imageArt.length)},minmax(0,1fr))`}
					>
						{imageArt.map((src) => <img src={src} alt="" loading="lazy" />)}
					</a>
					<div class="lab-wing-body">
						<span class="lab-section-eyebrow">Images</span>
						<h2><a href="/lab/image-quality/">Image quality</a></h2>
						<p>Image models answer five fixed briefs. Compare the pictures side by side and rate them.</p>
						<div class="lab-stats">
							<div class="lab-stat"><b>{suite.prompts.length}</b><span>Briefs</span></div>
							<div class="lab-stat"><b>{new Set(imageRuns.map((run) => run.model)).size}</b><span>Models</span></div>
							<div class="lab-stat"><b>{imageCount}</b><span>Images</span></div>
						</div>
						<div data-image-pair data-runs={JSON.stringify(imageRunsForScript)}>
							<ScorePair
								compact
								machine={{
									label: 'Checks',
									value: bestChecks?.score ?? '–',
									max: 100,
									sub: !bestChecks ? 'no runs yet' : allPass ? 'every model passes' : `best · ${bestChecks.label}`,
								}}
								human={{ label: 'Visitors', max: 5 }}
							/>
						</div>
						<div class="lab-wing-foot">
							<span>Rate quality, adherence, and fidelity</span>
							<a class="btn btn-sm" href="/lab/image-quality/#compare">Rate the images →</a>
						</div>
					</div>
				</article>
			</div>

			<aside class="lab-score-callout lab-score-callout--plain lab-score-callout--wide">
				<span class="lab-score-callout-icon" aria-hidden="true">★</span>
				<div>
					<strong>We have numbers. You decide the score.</strong>
					<p>
						Scripts check the technical details. They cannot tell if a game is fun or a picture is good.
						Your ratings sit next to the machine score on every page.
					</p>
				</div>
			</aside>
		</main>
		<Footer />
		<script>
			import { ConvexClient } from 'convex/browser';
			import { api } from '../../../convex/_generated/api';
			import { visitorScore } from '../../lib/image-scores';
			import { leader, MIN_VOTES_FOR_BEST } from '../../lib/leaders';

			// Fills the people's half of each card with the best live rating. A run needs
			// MIN_VOTES_FOR_BEST ratings first, so one early vote cannot crown it.
			const url = import.meta.env.PUBLIC_CONVEX_URL;
			const gamePair = document.querySelector<HTMLElement>('[data-game-pair]');
			const imagePair = document.querySelector<HTMLElement>('[data-image-pair]');
			const show = (pair: HTMLElement | null, best: ReturnType<typeof leader>) => {
				if (!pair) return;
				pair.querySelector('[data-human-value]')!.textContent = best ? best.score.toFixed(1) : '–';
				pair.querySelector('[data-human-sub]')!.textContent = best ? `best · ${best.label}` : 'not enough ratings yet';
			};
			const unavailable = (pair: HTMLElement | null) => {
				if (pair) pair.querySelector('[data-human-sub]')!.textContent = 'ratings unavailable';
			};

			if (!url) {
				unavailable(gamePair);
				unavailable(imagePair);
			} else {
				const client = new ConvexClient(url);
				const labels = JSON.parse(gamePair?.dataset.labels ?? '{}') as Record<string, string>;
				client.onUpdate(api.votes.allRatings, {}, (ratings) => {
					show(gamePair, leader(Object.entries(ratings)
						.filter(([key, rating]) => rating.count >= MIN_VOTES_FOR_BEST && labels[key])
						.map(([key, rating]) => ({ label: labels[key], score: rating.overall }))));
				}, () => unavailable(gamePair));

				type Run = { slug: string; model: string; produced: string[] };
				const runs = JSON.parse(imagePair?.dataset.runs ?? '[]') as Run[];
				client.onUpdate(api.votes.imageRatings, {}, (ratings) => {
					show(imagePair, leader(runs.flatMap((run) => {
						const { score, votes } = visitorScore(ratings, run.slug, run.produced);
						return score !== null && votes >= MIN_VOTES_FOR_BEST ? [{ label: run.model, score }] : [];
					})));
				}, () => unavailable(imagePair));

				window.addEventListener('pagehide', (event) => {
					if (!event.persisted) void client.close();
				});
			}
		</script>
	</body>
</html>
