---
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import LabTabs from '../../../../components/lab/LabTabs.astro';
import RatingRows from '../../../../components/lab/RatingRows.astro';
import ScorePair from '../../../../components/lab/ScorePair.astro';
import { imageLab, preview, type ImagePrompt, type ImageRun } from '../../../../lib/image-lab';
import '../../../../styles/lab.css';
import '../../../../styles/image-lab.css';

export function getStaticPaths() {
	return imageLab.runs.flatMap((run) =>
		imageLab.suite.prompts.map((prompt) => ({ params: { run: run.slug, prompt: prompt.id }, props: { run, prompt } })),
	);
}

const { run, prompt } = Astro.props as { run: ImageRun; prompt: ImagePrompt };
const { prompts } = imageLab.suite;
const image = run.images.find((entry) => entry.promptId === prompt.id);
const nextPrompt = prompts[(prompts.indexOf(prompt) + 1) % prompts.length];
const nextImage = run.images.find((entry) => entry.promptId === nextPrompt.id);
// The same brief answered by every other model, so visitors can flip between answers.
const others = imageLab.runs.flatMap((other) => {
	const answer = other.images.find((entry) => entry.promptId === prompt.id);
	return other.slug === run.slug || !answer?.file ? [] : [{ run: other, image: answer }];
});
const checks = [
	['Opens as one image', image?.checks.decodes, 40],
	[`${imageLab.suite.minimumShortEdge} px or more on the short edge`, image?.checks.resolution, 30],
	[`Aspect ratio within ${imageLab.suite.aspectRatioTolerance * 100}%`, image?.checks.aspectRatio, 30],
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${prompt.title} | ${run.model} | Image quality`}
			description={`Inspect and rate ${run.model}'s answer to "${prompt.title}". See the exact brief, the checks, and visitor scores.`}
		/>
	</head>
	<body>
		<Header />
		<main class="lab-main image-lab">
			<LabTabs active="images" />
			<div class="lab-header" style="padding-bottom:var(--space-md)">
				<p class="crumb">
					<a href="/lab/">The Lab</a> / <a href="/lab/image-quality/">Images</a> / {prompt.title} / {run.model}
				</p>
				<h1 style="font-size:2.2rem">{prompt.title}</h1>
				<p class="lab-lede" style="font-size:1rem">
					{run.model} via {run.provider}. First try, no edits.
					{image?.file && ` ${image.width} × ${image.height} px.`}
				</p>
			</div>

			<div class="rundetail image-detail">
				<div>
					{
						image?.file ? (
							<a class="image-hero" href={image.file} target="_blank" rel="noopener">
								<img src={preview(image)} alt={`${prompt.title}, generated by ${run.model}`} />
							</a>
						) : (
							<p class="image-missing">No readable image for this brief.</p>
						)
					}
					<div class="image-actions">
						{image?.file && <a class="btn btn-sm" href={image.file} target="_blank" rel="noopener">Open full size ↗</a>}
						<a class="btn btn-secondary btn-sm" href="/lab/image-quality/#compare">All images</a>
					</div>

					<div class="image-swap">
						{others.map(({ run: other, image: answer }) => (
							<a href={`/lab/image-quality/${other.slug}/${prompt.id}/`}>
								<img src={preview(answer)} alt="" loading="lazy" />
								<span><small>Same brief, other model</small><b>{other.model}</b></span>
							</a>
						))}
						{nextPrompt !== prompt && (
							<a href={`/lab/image-quality/${run.slug}/${nextPrompt.id}/`}>
								{nextImage?.file ? <img src={preview(nextImage)} alt="" loading="lazy" /> : <span class="image-swap-empty" />}
								<span><small>Next brief, same model</small><b>{nextPrompt.title}</b></span>
							</a>
						)}
					</div>

					<section class="image-panel">
						<h4>The brief</h4>
						<p>{prompt.prompt}</p>
						<p class="image-focus">Review focus: {prompt.focus}</p>
						{prompt.reference && (
							<a href={`/lab/images/${prompt.reference}`} target="_blank" rel="noopener">
								<img class="image-reference" src={`/lab/images/${prompt.reference}`} alt="Fixed reference image given to the model" loading="lazy" />
							</a>
						)}
					</section>
				</div>

				<aside data-image-detail data-run={run.slug} data-prompt={prompt.id}>
					<ScorePair
						machine={{ label: 'Checks', value: image?.total ?? 0, max: 100, sub: `measured · ${run.scorerVersion}` }}
						human={{ label: 'Visitors', max: 5, sub: image?.file ? 'loading' : 'nothing to rate' }}
					/>

					{
						image?.file && (
							<section class="votebox">
								<h4>Rate this image</h4>
								<p class="lede">The checks only prove the file is usable. Whether it is good is your call.</p>
								<div class="vrows">
									<RatingRows
										axes={[
											['quality', 'Quality', 'craft and finish'],
											['adherence', 'Adherence', 'did what was asked'],
											['fidelity', 'Fidelity', 'counts, text, likeness'],
										]}
									/>
									<button type="button" class="btn btn-sm vsubmit" data-submit disabled>Save rating</button>
								</div>
								<div class="vfoot">
									<span data-vote-status role="status">1 major failure · 3 mixed · 5 meets the brief. No account; one rating per browser.</span>
								</div>
							</section>
						)
					}

					<section class="image-panel">
						<h4>Checks · {image?.total ?? 0} / 100</h4>
						{checks.map(([label, passed, points]) => (
							<div class="image-check">
								<span>{label}</span>
								<b class:list={{ failed: !passed }}>{passed ? points : 0} / {points}</b>
							</div>
						))}
						{image?.error && <p class="image-focus">{image.error}</p>}
					</section>

					<section class="image-panel">
						<h4>Run record</h4>
						<dl>
							<dt>Generated</dt>
							<dd>{run.ranAt.slice(0, 10)}</dd>
							<dt>Time</dt>
							<dd>{run.durationMs === null ? 'Unknown' : `${Math.round(run.durationMs / 1000)} s for the run`}</dd>
							<dt>Cost</dt>
							<dd>{run.costUsd === null ? 'Unknown' : `$${run.costUsd}`}</dd>
							<dt>Settings</dt>
							<dd>{run.settings}</dd>
							<dt>Notes</dt>
							<dd>{run.notes}</dd>
							<dt>Suite</dt>
							<dd>{run.suiteVersion} / {run.scorerVersion}</dd>
						</dl>
					</section>
				</aside>
			</div>
		</main>
		<Footer />
		<script>
			import { startImageVote } from '../../../../scripts/image-vote';
			startImageVote();
		</script>
	</body>
</html>
