---
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import { imageLab, preview, type ImageRun, type ImagePrompt } from '../../../../lib/image-lab';
import '../../../../styles/lab.css';
import '../../../../styles/image-lab.css';
export function getStaticPaths() {
  return imageLab.runs.flatMap(run => imageLab.suite.prompts.map(prompt => ({params: {run: run.slug, prompt: prompt.id}, props: {run, prompt}})));
}
const {run, prompt} = Astro.props as {run: ImageRun; prompt: ImagePrompt};
const image = run.images.find(image => image.promptId === prompt.id);
const axes = [['quality', 'Visual quality'], ['adherence', 'Prompt adherence'], ['fidelity', 'Task fidelity']];
---
<!doctype html><html lang="en"><head><BaseHead title={`${prompt.title} | ${run.model} | Image Lab`} description={`Inspect and rate ${run.model}'s ${prompt.title}. Compare the original output with the exact prompt and reference.`} /></head>
<body><Header /><main class="lab-main image-lab">
  <p class="crumb"><a href="/lab/">The Lab</a> / <a href="/lab/image-quality/">Image quality</a> / {prompt.title}</p>
  <h1>{prompt.title}</h1><p class="lab-lede">{run.model} · {run.provider}</p>
  <div class="image-detail"><section>
    {image?.file ? <><a href={image.file} target="_blank" rel="noopener"><img class="image-full" src={preview(image)} alt={`${prompt.title}, generated by ${run.model}`} /></a><p><a href={image.file} target="_blank" rel="noopener">Open original at full resolution</a> · {image.width} × {image.height}</p></> : <p class="image-missing">No readable output for this prompt.</p>}
    <h2>Exact prompt</h2><p>{prompt.prompt}</p><p>Review focus: {prompt.focus}</p>
    {prompt.reference && <><h2>Fixed reference</h2><a href={`/lab/images/${prompt.reference}`} target="_blank" rel="noopener"><img class="image-reference" src={`/lab/images/${prompt.reference}`} alt="Fixed input supplied to the model" /></a></>}
  </section><aside>
    <h2>Objective checks</h2><p><strong>{image?.total ?? 0} / 100</strong>. Delivery checks, not artistic quality.</p>
    <ul><li>Decodes as a single raster: {image?.checks.decodes ? '40 / 40' : '0 / 40'}</li><li>At least 1024 pixels on the short edge: {image?.checks.resolution ? '30 / 30' : '0 / 30'}</li><li>Requested aspect ratio within 2%: {image?.checks.aspectRatio ? '30 / 30' : '0 / 30'}</li></ul>
    <h2>Visitor scores</h2><p data-image-rating={`${run.slug}/${prompt.id}`}>Loading ratings</p>
    {image?.file && <form data-image-vote data-run={run.slug} data-prompt={prompt.id}>
      <h3>Rate this image</h3><p>1 means major failure. 3 means mixed. 5 means fully meets the brief. One rating per browser; submit again to update it.</p>
      <fieldset disabled>{axes.map(([axis,label]) => <label>{label}<select name={axis} required><option value="">Choose a score</option>{[1,2,3,4,5].map(value => <option value={value}>{value}</option>)}</select><span data-axis-average={axis}></span></label>)}<button type="submit" class="btn btn-sm">Save rating</button></fieldset>
      <p data-vote-status role="status">Connecting to ratings</p>
    </form>}
    {!image?.file && <p data-ratings-status aria-live="polite"></p>}
    <h2>Run record</h2><dl><dt>Generated</dt><dd>{run.ranAt}</dd><dt>Settings</dt><dd>{run.settings}</dd><dt>Notes</dt><dd>{run.notes}</dd><dt>Time</dt><dd>{run.durationMs === null ? 'Unknown' : `${run.durationMs / 1000} seconds`}</dd><dt>Cost</dt><dd>{run.costUsd === null ? 'Unknown' : `$${run.costUsd}`}</dd><dt>Suite / scorer</dt><dd>{run.suiteVersion} / {run.scorerVersion}</dd></dl>
  </aside></div>
</main><Footer /><script>import '../../../../scripts/image-ratings';</script></body></html>
