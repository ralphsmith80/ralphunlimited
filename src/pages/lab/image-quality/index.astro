---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LabTabs from '../../../components/lab/LabTabs.astro';
import ScorePair from '../../../components/lab/ScorePair.astro';
import { compareData, imageLab, preview } from '../../../lib/image-lab';
import '../../../styles/lab.css';
import '../../../styles/image-lab.css';

const { suite, runs } = imageLab;
const images = runs.flatMap((run) => run.images.filter((image) => image.file));
const models = new Set(runs.map((run) => run.model)).size;
const allPass = runs.length > 0 && runs.every((run) => run.total === 100);
// The compare script sorts and filters with this. Ratings arrive live from Convex.
const data = JSON.stringify(compareData()).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Image quality | The Lab"
			description="Image models answer five fixed briefs. Compare every model's image side by side and rate them."
		/>
	</head>
	<body>
		<Header />
		<main class="lab-main image-lab">
			<LabTabs active="images" />
			<div class="lab-header">
				<p class="crumb"><a href="/lab/">The Lab</a> / Images / {suite.version}</p>
				<span class="lab-eyebrow">Image benchmark</span>
				<h1>Image quality</h1>
				<p class="lab-lede">
					Five briefs. Each model gets one try per brief, with the same reference images. Look at the
					work and score it yourself.
				</p>
				<div class="lab-stats">
					<div class="lab-stat"><b>{suite.prompts.length}</b><span>Briefs</span></div>
					<div class="lab-stat"><b>{models}</b><span>Models</span></div>
					<div class="lab-stat"><b>{images.length}</b><span>Images</span></div>
					<div class="lab-stat"><b data-vote-total>–</b><span>Visitor ratings</span></div>
				</div>
				<aside class="lab-score-callout lab-score-callout--plain">
					<span class="lab-score-callout-icon" aria-hidden="true">★</span>
					<div>
						<strong>
							{allPass ? 'Every model passes the checks. The pictures are not equal.' : 'The checks cannot see quality. You can.'}
						</strong>
						<p>
							Checks only prove that an image opens, is big enough, and has the right shape. Only people
							can judge the craft. Open any image to rate it.
						</p>
					</div>
				</aside>
			</div>

			<section class="lab-section" id="compare" aria-labelledby="compare-heading" data-compare>
				<div class="lab-section-head">
					<div>
						<span class="lab-section-eyebrow">Compare</span>
						<h2 id="compare-heading">Brief by brief</h2>
					</div>
					<p>Rows are briefs. Columns are models. Open an image to see it full size and rate it.</p>
				</div>

				{
					runs.length === 0 ? (
						<p>No image runs have been published yet. The briefs are ready below.</p>
					) : (
						<div class="compare-controls">
							<div class="compare-group">
								<span class="compare-label" id="sort-label">Sort by</span>
								<div class="toggle" role="group" aria-labelledby="sort-label">
									<button type="button" class="hum" data-sort="visitors" data-on="true">Visitor rating</button>
									<button type="button" data-sort="checks" data-on="false">Checks</button>
									<button type="button" data-sort="newest" data-on="false">Newest</button>
									<button type="button" data-sort="name" data-on="false">Name</button>
								</div>
							</div>
							<div class="compare-group">
								<span class="compare-label" id="columns-label">Columns</span>
								<div class="toggle" role="group" aria-labelledby="columns-label">
									<button type="button" data-columns="model" data-on="true">One model each</button>
									<button type="button" class="hum" data-columns="best" data-on="false">Best first in each brief</button>
								</div>
							</div>
							<div class="compare-group compare-models">
								<span class="compare-label" id="models-label">Models</span>
								<div class="game-filters" role="group" aria-labelledby="models-label">
									{runs.map((run) => (
										<button type="button" data-model={run.slug} aria-pressed="true">{run.model}</button>
									))}
								</div>
							</div>
							<div class="compare-nav">
								<span data-position aria-live="polite"></span>
								<button type="button" data-step="-1" aria-label="Show previous models">‹</button>
								<button type="button" data-step="1" aria-label="Show more models">›</button>
							</div>
						</div>
					)
				}

				{
					runs.length > 0 && (
						<div class="compare-row compare-head" data-head>
							<div />
							<div class="compare-track" data-track>
								{runs.map((run) => (
									<div class="compare-model" data-run={run.slug}>
										<span class="compare-who">
											<span class="compare-crown" data-crown hidden>Leads</span>
											{run.model}
											<small>{run.provider} · {run.ranAt.slice(0, 10)}</small>
										</span>
										<ScorePair
											compact
											machine={{ label: 'Checks', value: run.total.toFixed(0), max: 100 }}
											human={{ label: 'Visitors', max: 5, sub: 'loading' }}
										/>
									</div>
								))}
							</div>
						</div>
					)
				}

				{
					suite.prompts.map((prompt) => (
						<div class="compare-row" data-prompt={prompt.id}>
							<div class="compare-brief">
								<h3>{prompt.title}</h3>
								<p class="compare-focus">{prompt.focus}</p>
								<details>
									<summary>Read the prompt</summary>
									<p>{prompt.prompt}</p>
								</details>
								{prompt.reference && (
									<a class="compare-ref" href={`/lab/images/${prompt.reference}`} target="_blank" rel="noopener">
										<span>Fixed reference</span>
										<img src={`/lab/images/${prompt.reference}`} alt={`Reference image for ${prompt.title}`} loading="lazy" />
									</a>
								)}
							</div>
							{runs.length > 0 && (
								<div class="compare-track" data-track>
									{runs.map((run) => {
										const image = run.images.find((entry) => entry.promptId === prompt.id);
										return (
											<a class="compare-tile" data-run={run.slug} href={`/lab/image-quality/${run.slug}/${prompt.id}/`}>
												<span class="compare-img">
													{image?.file ? (
														<img src={preview(image)} alt={`${prompt.title}, generated by ${run.model}`} loading="lazy" />
													) : (
														<span class="image-missing">No image</span>
													)}
												</span>
												<span class="compare-body">
													<span class="compare-owner">
														<b>{run.model}</b>
														<span data-rank />
													</span>
													<span class="compare-scores">
														{image?.file && (
															<span class="badge-human" data-image-rating={`${run.slug}/${prompt.id}`}>★ –</span>
														)}
														<span class="badge-machine">✓ {image?.total ?? 0}</span>
														<span class="compare-cta">{image?.file ? 'Rate →' : 'Details →'}</span>
													</span>
												</span>
											</a>
										);
									})}
								</div>
							)}
						</div>
					))
				}

				<p class="crumb compare-foot">
					Suite {suite.version} · minimum short edge {suite.minimumShortEdge} px · aspect ratio within{' '}
					{suite.aspectRatioTolerance * 100}% · first output only, no edits or retries.
				</p>
				<p class="crumb" data-ratings-status aria-live="polite"></p>
			</section>
		</main>
		<Footer />
		<script type="application/json" id="compare-data" set:html={data} />
		<script>
			import { startCompare } from '../../../scripts/image-compare';
			startCompare();
		</script>
	</body>
</html>
