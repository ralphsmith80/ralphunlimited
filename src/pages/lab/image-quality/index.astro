---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { imageLab, preview } from '../../../lib/image-lab';
import '../../../styles/lab.css';
import '../../../styles/image-lab.css';
---
<!doctype html>
<html lang="en"><head><BaseHead title="Image quality | The Lab" description="Compare five image prompts across models. Inspect original images, objective delivery checks, and visitor quality scores." /></head>
<body><Header /><main class="lab-main image-lab">
  <p class="crumb"><a href="/lab/">The Lab</a> / Image quality</p>
  <h1>Image quality</h1>
  <p class="lab-lede">Five briefs, the same reference images, and the first output from each model. Inspect the work and rate each image.</p>
  <p>Objective scores measure delivery: a readable image, enough pixels, and the requested aspect ratio. Visitor scores judge quality. They stay separate.</p>
  <nav><a href="#scores">Compare scores</a> · <a href="#gallery">Browse images</a> · <a href="#prompts">Read the prompts</a></nav>
  <section id="scores"><h2>All scores</h2>
    <p>Objective checks use a 100-point scale. Visitor scores use a 5-point scale. A run needs ratings on every image it produced before it has an overall visitor score. Missing outputs score 0 on the objective checks and are not rated.</p>
    <div class="image-table-scroll"><table><caption>Every run, with scores for each prompt</caption><thead><tr><th scope="col">Model / run</th><th scope="col">Objective mean</th>{imageLab.suite.prompts.map(p => <th scope="col">{p.title}<small>Objective / visitors</small></th>)}<th scope="col">Visitors mean<small>All produced images</small></th></tr></thead>
      <tbody>{imageLab.runs.map(run => <tr><th scope="row"><a href={`#${run.slug}`}>{run.model}</a><small>{run.provider} · {run.ranAt.slice(0,10)}<br />{run.slug}</small></th><td>{run.total.toFixed(1)} / 100</td>{imageLab.suite.prompts.map(p => { const image = run.images.find(i => i.promptId === p.id); return <td><a href={`/lab/image-quality/${run.slug}/${p.id}/`}>{image?.total ?? 0} / 100</a><small data-image-rating={`${run.slug}/${p.id}`}>Loading ratings</small></td>; })}<td data-run-rating={run.slug} data-rated-prompts={run.images.filter(i => i.file).map(i => i.promptId).join(' ')}>Loading ratings</td></tr>)}</tbody>
    </table></div>
    {!imageLab.runs.length && <p>No image runs have been published yet. The fixed prompts are ready below.</p>}
    <p data-ratings-status aria-live="polite"></p>
  </section>
  <section id="gallery"><h2>The gallery</h2>{imageLab.runs.map(run => <section id={run.slug} class="image-run"><h3>{run.model}</h3><p>{run.provider} · {run.ranAt} · {run.total.toFixed(1)}/100 objective checks</p><div class="image-grid">{imageLab.suite.prompts.map(p => { const image = run.images.find(i => i.promptId === p.id); return <article><a href={`/lab/image-quality/${run.slug}/${p.id}/`}>{image?.file ? <img src={preview(image)} alt={`${p.title}, generated by ${run.model}`} loading="lazy" /> : <div class="image-missing">Missing output</div>}<h4>{p.title}</h4></a><p>{image?.total ?? 0}/100 objective · <span data-image-rating={`${run.slug}/${p.id}`}>Loading ratings</span></p><a href={`/lab/image-quality/${run.slug}/${p.id}/`}>Inspect and rate</a></article>; })}</div></section>)}</section>
  <section id="prompts"><h2>The five prompts</h2><p>Suite {imageLab.suite.version}. Minimum short edge: {imageLab.suite.minimumShortEdge} pixels. Aspect ratio tolerance: {imageLab.suite.aspectRatioTolerance * 100}%.</p>{imageLab.suite.prompts.map(p => <details><summary>{p.title}</summary><p>{p.prompt}</p><p>Review focus: {p.focus}</p>{p.reference && <a href={`/lab/images/${p.reference}`} target="_blank" rel="noopener"><img class="image-reference" src={`/lab/images/${p.reference}`} alt={`${p.title} fixed input reference`} loading="lazy" />Open the fixed reference</a>}</details>)}</section>
</main><Footer /><script>import '../../../scripts/image-ratings';</script></body></html>
