---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { benchmarks, bandColour, runLabel, type LabBenchmark, type LabRun } from '../../../lib/lab';
import '../../../styles/lab.css';

export function getStaticPaths() {
	return benchmarks.flatMap((benchmark) =>
		benchmark.runs.map((run) => ({
			params: { benchmark: benchmark.id, run: run.slug },
			props: { benchmark, run },
		})),
	);
}

const { benchmark, run } = Astro.props as { benchmark: LabBenchmark; run: LabRun };
const megabytes = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const hero = run.shots[1] ?? run.shots[0] ?? null;
// The hero already shows one frame; the strip below shows the rest.
const otherShots = run.shots.filter((shot) => shot !== hero);
const description = `${runLabel(run)} scored ${run.total}/100 on ${benchmark.name.split(' — ')[0]}.`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${runLabel(run)} — ${benchmark.name.split(' — ')[0]}`} description={description} />
	</head>
	<body>
		<Header />
		<main class="lab-main">
			<div class="lab-header" style="padding-bottom:var(--space-md)">
				<p class="crumb">
					<a href="/lab/">The Lab</a> / <a href={`/lab/${benchmark.id}/`}>{benchmark.id}</a> /
					{run.slug}
				</p>
				<h1 style="font-size:2.2rem">{runLabel(run)}</h1>
				<p class="lab-lede" style="font-size:1rem">
					Run on {run.ranAt.slice(0, 10)} via the {run.agent} CLI{
						run.reasoning ? ` at ${run.reasoning} reasoning` : ''
					}. One shot, unattended.
				</p>
			</div>

			{
				!run.gatePassed && (
					<div class="note">
						<p>
							This candidate never got past the build gate — it failed at{' '}
							<code>{run.gateFailedAt}</code>, so there is nothing to play and no score to give.
						</p>
					</div>
				)
			}

			<div class="rundetail">
				<div>
					{
						run.playable ? (
							<a class="playframe" href={run.playable} data-play target="_blank" rel="noopener">
								{hero && <img src={`/lab/${hero}`} alt={`${runLabel(run)} gameplay`} />}
								<span class="ply">▶</span>
							</a>
						) : (
							<div class="playframe">
								<span class="ply">—</span>
							</div>
						)
					}
					<div style="display:flex;gap:.6rem;margin-top:.85rem;flex-wrap:wrap">
						{run.playable && <a class="btn btn-sm" href={run.playable} data-play target="_blank" rel="noopener">Play fullscreen →</a>}
						<a class="btn btn-secondary btn-sm" href={`/lab/${benchmark.id}/`}>All runs</a>
					</div>
					{
						otherShots.length > 0 && (
							<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem;margin-top:1.25rem">
								{otherShots.map((shot) => (
									<img
										src={`/lab/${shot}`}
										alt="Probe frame"
										style="border:var(--border-subtle);border-radius:var(--radius-sm)"
										loading="lazy"
									/>
								))}
							</div>
						)
					}
				</div>

				<aside
					id="lab-run"
					data-bench={benchmark.id}
					data-slug={run.slug}
					data-playable={run.playable ? "true" : "false"}
				>
					<div class="dualscore">
						<div class="machine">
							<div class="k">Harness</div>
							<div class="v">{run.total}<small> / 100</small></div>
							<div class="sub">measured · {benchmark.rubricId}</div>
						</div>
						<div class="human">
							<div class="k">Players</div>
							<div class="v" data-players-value>–<small> / 5</small></div>
							<div class="sub" data-players-count>no ratings yet</div>
						</div>
					</div>

					{
						run.playable && (
							<section class="votebox">
								<h4>Rate this build</h4>
								<p class="lede">
									The harness measures what a machine can measure. Whether it is any fun is your
									call.
								</p>
								<div class="vlock" data-gate>
									Play for a minute to unlock rating. No account; one vote per browser.
								</div>
								<div class="vrows" data-locked="true">
									{
										[
											["fun", "Fun", "one more run?"],
											["depth", "Depth", "systems"],
											["polish", "Polish", "juice and feel"],
										].map(([key, label, hint]) => (
											<div class="vrow" data-axis={key}>
												<span class="vlabel">
													{label}
													<em>{hint}</em>
												</span>
												<span class="stars">
													{[1, 2, 3, 4, 5].map((value) => (
														<button type="button" class="star" data-value={value}>
															{value}
														</button>
													))}
												</span>
												<span class="vavg" data-avg>
													–
												</span>
											</div>
										))
									}
									<button type="button" class="btn btn-sm vsubmit" data-submit disabled>
										Submit rating
									</button>
								</div>
								<div class="vfoot">
									<span data-vote-status>Ratings are live and update as they arrive.</span>
								</div>
							</section>
						)
					}

					<div class="scorepanel" style="margin-top:var(--space-lg)">
					<div class="head">
						<div>
							<div class="n" style={`color:${bandColour(run.band)}`}>
								{run.total}<span> / 100</span>
							</div>
							<div
								style="font-family:var(--font-mono);font-size:.6rem;letter-spacing:.09em;color:var(--text-muted);text-transform:uppercase;margin-top:.3rem"
							>
								{benchmark.rubricId} · {run.band}
							</div>
						</div>
					</div>

					{
						run.criteria.map((criterion) => (
							<div class="crit">
								<div class="cl">
									<span>
										{criterion.label} <em>×{criterion.weight}</em>
									</span>
									<b>{criterion.score} / 5</b>
								</div>
								<div class="cb">
									<i
										style={`width:${(criterion.score / 5) * 100}%;background:${bandColour(run.band)}`}
									/>
								</div>
								<div class="sig">{criterion.rationale}</div>
							</div>
						))
					}

					{
						run.observations.length > 0 && (
							<div class="obs">
								<h4>Measured, not scored</h4>
								{run.observations.map((observation) => (
									<p>
										{observation.label}: {String(observation.value)}
										{observation.detail ? ` — ${observation.detail}` : ''}
									</p>
								))}
								<p style="margin-top:.5rem;opacity:.8">
									These varied between repeat runs of the same build, so they are published as
									observations rather than points.
								</p>
							</div>
						)
					}

					<div class="obs">
						<h4>Build</h4>
						<p>{megabytes(run.buildBytes)} of static output</p>
						<p>scorer {benchmark.scorerVersion}</p>
					</div>
					</div>
				</aside>
			</div>
		</main>
		<Footer />
		<script>
			import { ConvexClient } from "convex/browser";
			import { api } from "../../../../convex/_generated/api";

			const root = document.getElementById("lab-run");
			const url = import.meta.env.PUBLIC_CONVEX_URL;
			if (root && url) {
				const benchId = root.dataset.bench!;
				const runSlug = root.dataset.slug!;
				const client = new ConvexClient(url);

				// --- live averages --------------------------------------------------
				const valueEl = root.querySelector("[data-players-value]")!;
				const countEl = root.querySelector("[data-players-count]")!;
				client.onUpdate(api.votes.runRatings, { benchId, runSlug }, (ratings) => {
					valueEl.innerHTML = ratings.count
						? `${ratings.overall}<small> / 5</small>`
						: `–<small> / 5</small>`;
					countEl.textContent = ratings.count
						? `${ratings.count} rating${ratings.count === 1 ? "" : "s"} · live`
						: "no ratings yet";
					for (const axis of ["fun", "depth", "polish"] as const) {
						const cell = root.querySelector(`[data-axis="${axis}"] [data-avg]`);
						if (cell) cell.innerHTML = ratings.count ? `<b>${ratings[axis]}</b> avg` : "–";
					}
				});

				// --- play gate: rating unlocks a minute after Play is clicked --------
				const playedKey = `lab-played:${benchId}/${runSlug}`;
				for (const link of document.querySelectorAll("[data-play]")) {
					link.addEventListener("click", () => {
						if (!localStorage.getItem(playedKey)) localStorage.setItem(playedKey, String(Date.now()));
					});
				}
				const gate = root.querySelector("[data-gate]");
				const rows = root.querySelector(".vrows") as HTMLElement | null;
				const tick = () => {
					const playedAt = Number(localStorage.getItem(playedKey) || 0);
					if (!playedAt) return;
					const remaining = 60_000 - (Date.now() - playedAt);
					if (remaining <= 0) {
						rows?.setAttribute("data-locked", "false");
						(gate as HTMLElement | null)?.style.setProperty("display", "none");
					} else if (gate) {
						gate.textContent = `Keep playing — rating unlocks in ${Math.ceil(remaining / 1000)}s.`;
					}
				};
				tick();
				setInterval(tick, 1_000);

				// --- star picking + submit ------------------------------------------
				const picks: Record<string, number> = {};
				const submit = root.querySelector("[data-submit]") as HTMLButtonElement | null;
				const status = root.querySelector("[data-vote-status]")!;
				for (const row of root.querySelectorAll("[data-axis]")) {
					const axis = (row as HTMLElement).dataset.axis!;
					for (const star of row.querySelectorAll(".star")) {
						star.addEventListener("click", () => {
							picks[axis] = Number((star as HTMLElement).dataset.value);
							for (const sibling of row.querySelectorAll(".star")) {
								(sibling as HTMLElement).dataset.on = String(
									Number((sibling as HTMLElement).dataset.value) <= picks[axis],
								);
							}
							if (submit) submit.disabled = !(picks.fun && picks.depth && picks.polish);
						});
					}
				}
				submit?.addEventListener("click", async () => {
					submit.disabled = true;
					let voterId = localStorage.getItem("lab-voter-id");
					if (!voterId) {
						voterId = crypto.randomUUID();
						localStorage.setItem("lab-voter-id", voterId);
					}
					try {
						await client.mutation(api.votes.castVote, {
							benchId,
							runSlug,
							voterId,
							fun: picks.fun,
							depth: picks.depth,
							polish: picks.polish,
						});
						status.textContent = "Your rating is in. Rate again any time to change it.";
					} catch (error) {
						status.textContent = `Could not save the rating: ${error instanceof Error ? error.message : error}`;
						submit.disabled = false;
					}
				});
			}
		</script>
	</body>
</html>
